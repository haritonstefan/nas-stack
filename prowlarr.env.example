PROWLARR_CONFIG_DIR=/volume2/docker/prowlarr/config
PROWLARR_PORT=9696

# --- secret: generated by up.sh on first run, never regenerated -------------

# 32-char lowercase hex, matching the app's own key format. Read at every
# start as PROWLARR__AUTH__APIKEY and never persisted to config.xml — losing
# this file mints a new key silently, breaking Configarr and Sonarr/Radarr
# app sync and the Homepage widget all at once, with no error anywhere.
PROWLARR_API_KEY=

# --- arr-bootstrap.sh / arr-indexers.sh only (not read by docker compose) ---

# How the bootstraps (running on the host) reach Prowlarr. Not used by
# anything inside a container: containers reach it as http://prowlarr:9696.
PROWLARR_URL=http://127.0.0.1:9696

# The trackers are added by ./arr-indexers.sh, run separately after up.sh.
# 0 skips adding the indexers, leaving Prowlarr empty for hand-adding.
ARR_INSTALL_INDEXERS=1
# Comma-separated Prowlarr definition names. Must exist in Prowlarr's Cardigann
# definitions; unknown names are warned about and skipped (Prowlarr fetches the
# definitions shortly after start, so a later re-run may find them).
ARR_INDEXERS=1337x,thepiratebay,yts,eztv,limetorrents,torlock,therarbg,knaben,glodls,magnetdl

# Private indexers, same definition-name rules as ARR_INDEXERS. Credentials for
# each come from ARR_INDEXER_<NAME>_USER / _PASS, where <NAME> is the definition
# name uppercased (non-alphanumerics become _). An indexer with missing
# credentials is skipped with a warning. Only username/password logins work —
# a definition wanting a cookie, passkey or 2FA is skipped with its field
# names printed, so it can be added by hand in the Prowlarr UI instead.
ARR_INDEXERS_PRIVATE=kinozal,rutracker,torrentleech
ARR_INDEXER_KINOZAL_USER=
ARR_INDEXER_KINOZAL_PASS=
ARR_INDEXER_RUTRACKER_USER=
ARR_INDEXER_RUTRACKER_PASS=
ARR_INDEXER_TORRENTLEECH_USER=
ARR_INDEXER_TORRENTLEECH_PASS=
