RADARR_CONFIG_DIR=/volume2/docker/radarr/config
RADARR_PORT=7878

# Single-consumer, unlike DOWNLOADS_DIR (shared.env): only Radarr reads this.
ARR_MOVIES_DIR=/volume1/Media/Movies

# --- secret: generated by up.sh on first run, never regenerated -------------

# 32-char lowercase hex, matching the app's own key format. Read at every
# start as RADARR__AUTH__APIKEY and never persisted to config.xml — losing
# this file mints a new key silently, breaking Prowlarr sync, Configarr and
# the Homepage widget all at once, with no error anywhere.
RADARR_API_KEY=

# --- arr-bootstrap.sh only (not read by docker compose) ---------------------

# How the bootstrap (running on the host) reaches Radarr. Not used by
# anything inside a container: containers reach it as http://radarr:7878.
RADARR_URL=http://127.0.0.1:7878

# Container path, not a host path — what the app sees.
RADARR_ROOT_FOLDER=/media/movies
