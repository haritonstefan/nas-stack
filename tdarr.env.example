TDARR_WEBUI_PORT=8265

# Holds server/ (database, plugins), configs/, logs/ and cache/. On the SSD.
TDARR_DATA_DIR=/volume2/docker/tdarr

# Same host paths as radarr's ARR_MOVIES_DIR and sonarr's ARR_SERIES_DIR —
# nas configure asks once and writes both.
TDARR_MOVIES_DIR=/volume1/Media/Movies
TDARR_SERIES_DIR=/volume1/Media/Series

# Subtitle languages to keep, comma-separated ISO 639-2 codes. Any spelling of
# a language matches (rum also keeps ron/ro). Untagged tracks are always kept.
# Empty = leave subtitles untouched, not "remove them all".
TDARR_SUBTITLE_LANGS=eng,rum
