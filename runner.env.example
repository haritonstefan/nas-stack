# Registration and job limits live in config.toml inside this dir, not here.
# See docs/manual-setup.md.

RUNNER_CONFIG_DIR=/volume2/docker/runner/config

# The CI cache, shared by all job slots. Jobs mount it through config.toml
# (docs/manual-setup.md), and runner-cache-cleaner expires it.
RUNNER_CACHE_DIR=/volume2/docker/runner/cache
