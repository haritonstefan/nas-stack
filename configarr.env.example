CONFIGARR_CONFIG_DIR=/volume2/docker/configarr/config
# Cached clones of the TRaSH and Recyclarr template repos. A few hundred MB.
CONFIGARR_REPOS_DIR=/volume2/docker/configarr/repos

# SONARR_API_KEY / RADARR_API_KEY are deliberately NOT here. The compose file
# needs both, so this is the one unit dispatched with four --env-file flags
# (shared.env, sonarr.env, radarr.env, configarr.env) instead of two: each key
# stays only in its own unit's file — the copy the app itself reads — so a
# rotated key can never go stale in a second copy nobody remembers to update.

# --- arr-bootstrap.sh only (not read by docker compose) ---------------------

# 0 skips the one-shot Configarr sync at bring-up. The ofelia unit still runs
# it on its own schedule regardless — nas install always creates the configarr
# container, and this flag only decides whether the first sync happens
# immediately.
#
# The templates and profiles themselves are not configured here: they live in
# configarr-config/config.yml, which nas install installs into CONFIGARR_CONFIG_DIR.
ARR_RUN_CONFIGARR=1
