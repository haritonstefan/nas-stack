LIDARR_CONFIG_DIR=/volume2/docker/lidarr/config
LIDARR_PORT=8686

# Single-consumer, unlike DOWNLOADS_DIR (shared.env): only Lidarr reads this.
ARR_MUSIC_DIR=/volume1/Media/Music

# --- secret: generated by nas install on first run, never regenerated -------------

# Read at every start as LIDARR__AUTH__APIKEY, never persisted to config.xml.
LIDARR_API_KEY=

# --- arr-bootstrap.sh only (not read by docker compose) ---------------------

# How the bootstrap (running on the host) reaches Lidarr. Not used by
# anything inside a container: containers reach it as http://lidarr:8686.
LIDARR_URL=http://127.0.0.1:8686

# Container path, not a host path — what the app sees.
LIDARR_ROOT_FOLDER=/media/music
