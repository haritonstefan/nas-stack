JELLYFIN_CONFIG_DIR=/volume2/docker/jellyfin/config
JELLYFIN_CACHE_DIR=/volume2/docker/jellyfin/cache

MEDIA_MOVIES_DIR=/volume1/Media/Movies
MEDIA_SERIES_DIR=/volume1/Media/Series
MEDIA_MUSIC_DIR=/volume1/Media/Music

# Confirm: stat -c '%g %G' /dev/dri/renderD128
RENDER_GID=105

# Both minted by jellyfin-bootstrap.sh and written back here (API keys live in
# Jellyfin's database and cannot be seeded via the environment). Leave empty —
# nas post-install recreates the container so the widget labels pick
# them up. Lose them and a re-run of the bootstrap restores them.
JELLYFIN_API_KEY=
JELLYFIN_SCAN_TASK_ID=

# --- jellyfin-bootstrap.sh only (not read by docker compose) -----------------

JELLYFIN_URL=http://127.0.0.1:8096
JELLYFIN_SERVER_NAME=Apollo

# Which clients count as local. Narrower than the default: this makes tailnet
# clients remote. See spec section 5.
JELLYFIN_LOCAL_SUBNET=192.168.0.0/24

JELLYFIN_METADATA_LANGUAGE=en
# Metadata region: picks release dates and certification scheme (US -> PG-13/R,
# GB -> 12A/15). Not a content filter, and unrelated to where the server lives —
# US simply has the most complete TMDb coverage.
JELLYFIN_METADATA_COUNTRY=US
JELLYFIN_UI_CULTURE=en-US

# 0 skips the post-bootstrap scan, which walks the whole media HDD.
JELLYFIN_SCAN_ON_BOOTSTRAP=1
# 0 skips the DLNA plugin install. Needs egress to Jellyfin's plugin repo.
JELLYFIN_INSTALL_DLNA=1

# The admin account is the shared identity: ADMIN_USER/ADMIN_PASSWORD in shared.env.
