TZ=Europe/Bucharest
PUID=1000
PGID=10

JELLYFIN_CONFIG_DIR=/volume2/docker/jellyfin/config
JELLYFIN_CACHE_DIR=/volume2/docker/jellyfin/cache

MEDIA_MOVIES_DIR=/volume1/Media/Movies
MEDIA_SERIES_DIR=/volume1/Media/Series
MEDIA_MUSIC_DIR=/volume1/Media/Music

# Jellyfin runs with network_mode: host, so it binds 8096 (web), 7359/udp
# (discovery) and 1900/udp (DLNA) on the host directly. Those ports come from
# Jellyfin's own config, NOT from compose — there is nothing to set here.

RENDER_GID=105

# Used by jellyfin-bootstrap.sh only (not by docker compose).
JELLYFIN_URL=http://127.0.0.1:8096
JELLYFIN_SERVER_NAME=Apollo
JELLYFIN_METADATA_LANGUAGE=en
# Region for metadata providers — controls release dates and which certification
# scheme is used (US -> PG-13/R, GB -> 12A/15, DE -> FSK). NOT a content filter:
# providers fall back to other regions when a title lacks data for this one.
# US has the most complete TMDb coverage; unrelated to where the server lives.
JELLYFIN_METADATA_COUNTRY=US
JELLYFIN_UI_CULTURE=en-US
# Trigger a full library scan at the end of bootstrap. Set to 0 to skip it on a
# large library — the scan walks the whole media HDD.
JELLYFIN_SCAN_ON_BOOTSTRAP=1
# Install the DLNA plugin during bootstrap (it is a plugin, not core, as of
# 10.10). Needs egress to Jellyfin's plugin repository, and the plugin only
# loads after the restart that up.sh already performs. Set to 0 to skip.
# DLNA has no authentication — anything on the LAN can browse exposed libraries.
JELLYFIN_INSTALL_DLNA=1
JELLYFIN_ADMIN_USER=admin
# No default on purpose — the script refuses to run if this is unset.
JELLYFIN_ADMIN_PASSWORD=
