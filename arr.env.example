# The API keys below are load-bearing forever, not just at first run. They are
# injected as SONARR__AUTH__APIKEY etc., which the apps read at every start in
# place of config.xml — so the key is never persisted there. Lose this file and
# each app silently generates and persists a new random key, breaking Prowlarr
# sync, Configarr and all three Homepage widgets at once, with no error anywhere.
# up.sh generates them on first run and never regenerates. Keep a copy.

TZ=Europe/Bucharest
PUID=1000
PGID=10

# Group-writable so Jellyfin (same 1000:10) can read what the arr apps write.
UMASK=002

SONARR_CONFIG_DIR=/volume2/docker/sonarr/config
RADARR_CONFIG_DIR=/volume2/docker/radarr/config
PROWLARR_CONFIG_DIR=/volume2/docker/prowlarr/config
QBITTORRENT_CONFIG_DIR=/volume2/docker/qbittorrent/config
SEERR_CONFIG_DIR=/volume2/docker/seerr/config
CONFIGARR_CONFIG_DIR=/volume2/docker/configarr/config
# Cached clones of the TRaSH and Recyclarr template repos. A few hundred MB.
CONFIGARR_REPOS_DIR=/volume2/docker/configarr/repos
# Kept out of the configarr config dir so nothing can mistake ofelia.ini for a
# configarr file.
OFELIA_CONFIG_DIR=/volume2/docker/ofelia/config

# Downloads live on the SSD and seed from there. Because this is a different
# filesystem from /volume1, every import is a copy rather than a hardlink —
# deliberate, so seeding never holds the media HDD awake. See spec section 8.
DOWNLOADS_DIR=/volume2/docker/downloads

# Must point at the same host dirs as MEDIA_MOVIES_DIR / MEDIA_SERIES_DIR in
# jellyfin.env. Separate names on purpose: up.sh sources every selected tier's
# env into one shell, and a shared name would let the last one win.
ARR_MOVIES_DIR=/volume1/Media/Movies
ARR_SERIES_DIR=/volume1/Media/Series

SONARR_PORT=8989
RADARR_PORT=7878
PROWLARR_PORT=9696
QBITTORRENT_PORT=8080
QBITTORRENT_TORRENT_PORT=6881
SEERR_PORT=5055

# Host `docker` group, owner of /var/run/docker.sock — ofelia needs it to start
# the configarr container. Must match core.env. Confirm: getent group docker
DOCKER_GID=121

# --- secrets: generated by up.sh on first run, never regenerated -------------

# 32-char lowercase hex, matching the apps' own key format.
SONARR_API_KEY=
RADARR_API_KEY=
PROWLARR_API_KEY=

# Injected as Seerr's API_KEY, which overwrites the apiKey stored in its
# settings.json at every start — load-bearing forever, exactly like the three
# keys above. Rotating the key in the Seerr UI does not survive a restart.
SEERR_API_KEY=

# qBittorrent mints a new random WebUI password on every start unless one is
# already stored, which would break the credentials Sonarr and Radarr hold. So
# up.sh generates this and seeds a PBKDF2 hash of it into qBittorrent.conf
# before first start. See spec section 8.
QBITTORRENT_USER=admin
QBITTORRENT_PASSWORD=

# --- arr-bootstrap.sh only (not read by docker compose) ---------------------

# How the bootstrap (running on the host) reaches each app. These are host
# addresses and are not used by anything inside a container: configarr hardcodes
# the container addresses in its own config.yml precisely so these cannot leak
# in and point it at itself.
SONARR_URL=http://127.0.0.1:8989
RADARR_URL=http://127.0.0.1:7878
PROWLARR_URL=http://127.0.0.1:9696
SEERR_URL=http://127.0.0.1:5055

# Container paths, not host paths — these are what the apps see.
SONARR_ROOT_FOLDER=/media/series
RADARR_ROOT_FOLDER=/media/movies

# Seed until ratio 2.0 or 14 days. qBittorrent then stops the torrent, and
# Sonarr/Radarr delete it AND its files (removeCompletedDownloads), freeing the
# SSD. Applied via qBittorrent.conf at first start, so changes here need that
# file removed.
QBITTORRENT_SEED_RATIO=2
QBITTORRENT_SEED_MINUTES=20160

# 0 skips adding the public indexers, leaving Prowlarr empty for hand-adding.
ARR_INSTALL_INDEXERS=1
# Comma-separated Prowlarr definition names. Must exist in Prowlarr's bundled
# Cardigann definitions; unknown names are warned about and skipped.
ARR_INDEXERS=1337x,thepiratebay,yts,eztv,limetorrents,torlock,therarbg,knaben,glodls,magnetdl

# Private indexers, same definition-name rules as ARR_INDEXERS. Credentials for
# each come from ARR_INDEXER_<NAME>_USER / _PASS, where <NAME> is the definition
# name uppercased (non-alphanumerics become _). An indexer with missing
# credentials is skipped with a warning. Only username/password logins work —
# a definition wanting a cookie, passkey or 2FA is skipped with its field
# names printed, so it can be added by hand in the Prowlarr UI instead.
ARR_INDEXERS_PRIVATE=kinozal,rutracker,torrentleech
ARR_INDEXER_KINOZAL_USER=
ARR_INDEXER_KINOZAL_PASS=
ARR_INDEXER_RUTRACKER_USER=
ARR_INDEXER_RUTRACKER_PASS=
ARR_INDEXER_TORRENTLEECH_USER=
ARR_INDEXER_TORRENTLEECH_PASS=

# 0 skips the one-shot Configarr sync at bring-up. Ofelia still runs it on its
# own schedule regardless — up.sh always creates the configarr container, and
# this flag only decides whether the first sync happens immediately.
#
# The templates and profiles themselves are not configured here: they live in
# configarr-config/config.yml, which up.sh installs into CONFIGARR_CONFIG_DIR.
ARR_RUN_CONFIGARR=1

# 0 skips Seerr's first-run setup (Jellyfin sign-in, library sync, Sonarr/
# Radarr wiring). The Jellyfin admin credentials are NOT duplicated here — the
# bootstrap reads them from jellyfin.env in a subshell (see the shared-name
# warning above ARR_MOVIES_DIR).
ARR_CONFIGURE_SEERR=1
# How Seerr (a container on nas-net) reaches Jellyfin, which is host-networked
# and NOT on nas-net — a container name will not resolve, and .local usually
# does not resolve inside containers either. The LAN IP, per DHCP reservation.
SEERR_JELLYFIN_HOST=192.168.0.231
SEERR_JELLYFIN_PORT=8096
