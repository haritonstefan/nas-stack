UNMANIC_PORT=8888

# Unmanic's database, settings and installed plugins. On the SSD.
UNMANIC_CONFIG_DIR=/volume2/docker/unmanic/config

# Scratch space for the file being remuxed. On the SSD; needs room for the
# largest file being processed.
UNMANIC_CACHE_DIR=/volume2/docker/unmanic/cache

# Same host paths as radarr's ARR_MOVIES_DIR and sonarr's ARR_SERIES_DIR —
# nas configure asks once and writes all of them.
UNMANIC_MOVIES_DIR=/volume1/Media/Movies
UNMANIC_SERIES_DIR=/volume1/Media/Series

# --- unmanic-bootstrap.sh only (not read by docker compose) -----------------

# Subtitle languages to keep, comma-separated. Any spelling of a language
# matches (rum also keeps ron/ro). Untagged tracks are always kept.
# Empty = leave subtitles untouched, not "remove them all".
UNMANIC_SUBTITLE_LANGS=eng,rum

# How the bootstrap (running on the host) reaches Unmanic. Not used by
# anything inside a container.
UNMANIC_URL=http://127.0.0.1:8888

# 0 skips Unmanic's setup (plugins, libraries, worker count) entirely.
UNMANIC_CONFIGURE=1
