# Vars genuinely reused by more than one service. Every docker compose
# invocation passes this file first via --env-file, then the unit's own —
# see up.sh/down.sh. A value here that a unit's own file also defines would be
# overridden by the unit's file (later --env-file wins), so don't duplicate
# these names in a per-service .env.example.

TZ=Europe/Bucharest
PUID=1000
PGID=10

# Group-writable so Jellyfin (same 1000:10) can read what the arr apps write.
UMASK=002

# Host `docker` group, owner of /var/run/docker.sock — needed by Homepage and
# Ofelia, the two containers with socket access. Confirm: getent group docker
DOCKER_GID=121

# How a container reaches something that is host-networked or is itself the
# host (Jellyfin; the Homepage/Seerr widgets that point at it) — neither a
# container name nor apollo.local reliably resolves from inside a container.
# The LAN IP, per DHCP reservation.
LAN_HOST=192.168.0.231

# Downloads live on the SSD and seed from there. Sonarr, Radarr and
# qBittorrent all mount this at the identical container path (/downloads) —
# qBittorrent reports absolute paths back for import matching, so any drift
# between them silently breaks every import. One value, shared by all three.
# Because this is a different filesystem from /volume1, every import is a
# copy rather than a hardlink — deliberate, so seeding never holds the media
# HDD awake. See spec section 8.
DOWNLOADS_DIR=/volume2/docker/downloads

# --- shared identity ---------------------------------------------------------

# One account backing both the Jellyfin admin login and the qBittorrent WebUI
# login (Seerr rides it too, via /auth/jellyfin — it has no credential of its
# own). up.sh prompts for ADMIN_PASSWORD once, the same way it used to prompt
# for the Jellyfin-only admin password, and seeds it into both places.
ADMIN_USER=stefan
ADMIN_PASSWORD=
