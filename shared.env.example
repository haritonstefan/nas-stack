# Vars genuinely reused by more than one service. Every docker compose
# invocation passes this file first via --env-file, then the unit's own —
# see the nas CLI. A value here that a unit's own file also defines would be
# overridden by the unit's file (later --env-file wins), so don't duplicate
# these names in a per-service .env.example.

TZ=Europe/Bucharest
PUID=1000
PGID=10

# Group-writable so Jellyfin (same 1000:10) can read what the arr apps write.
UMASK=002

# Host `docker` group, owner of /var/run/docker.sock — needed by Homepage, the
# one container with socket access. Confirm: getent group docker
DOCKER_GID=121

# How a container reaches something that is host-networked or is itself the
# host (Jellyfin; the Homepage/Seerr widgets that point at it) — neither a
# container name nor apollo.local reliably resolves from inside a container.
# The LAN IP, per DHCP reservation.
LAN_HOST=192.168.0.231

# One value for sonarr, radarr and qbittorrent, all mounting it at /downloads:
# qBittorrent reports absolute paths back for import matching, so any drift
# silently breaks every import. Deliberately a different filesystem from
# /volume1, so imports are copies, not hardlinks — see spec section 8.
DOWNLOADS_DIR=/volume2/docker/downloads

# --- admin login ---------------------------------------------------------------

# The qBittorrent WebUI login, read by its Homepage widget. Nothing sets it in
# qBittorrent for you: change it there by hand to match. Using the same account
# for Jellyfin's admin (and Seerr's sign-in through Jellyfin) is a convention,
# not something any file enforces.
ADMIN_USER=stefan
ADMIN_PASSWORD=
