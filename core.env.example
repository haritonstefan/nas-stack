TZ=Europe/Bucharest

# Homepage is the entrypoint: it binds host port 80 directly, so apollo.local
# (no port) opens the dashboard. Every other service is reached on its own port
# via a dashboard tile.
HOMEPAGE_HTTP_PORT=80

HOMEPAGE_CONFIG_DIR=/volume2/docker/homepage/config
# Homepage rejects any Host header not listed here with a 400. Comma-separated,
# no spaces. These are the addresses Homepage is reached AT — the NAS's own name
# and IP, not the clients' — so this is a short list, not a subnet.
#
# No wildcard or CIDR support: `192.168.0.*` and `192.168.0.0/24` are matched
# literally and reject everything. Each address must be listed in full. Add a
# tailnet name here too if you reach the dashboard over Tailscale.
#
# `*` disables the check entirely; only sensible because nothing forwards a port
# to this box. Prefer the explicit list.
HOMEPAGE_ALLOWED_HOSTS=apollo.local,192.168.0.231
PUID=1000
PGID=10

# GID of the host `docker` group, owner of /var/run/docker.sock (mode 0660).
# Homepage's primary GID — without it, label autodiscovery fails with EACCES
# and no container appears on the dashboard. Confirm with: getent group docker
DOCKER_GID=121
