TZ=Europe/Bucharest
PUID=1000
PGID=10

HOMEPAGE_HTTP_PORT=80
HOMEPAGE_CONFIG_DIR=/volume2/docker/homepage/config

# Every name/address Homepage is reached AT (the NAS's own, not the clients').
# Comma-separated, no spaces, no wildcards — an unlisted Host header gets a 400.
# See spec section 7.
HOMEPAGE_ALLOWED_HOSTS=apollo.local,192.168.0.231

# Host `docker` group, owner of /var/run/docker.sock. Confirm: getent group docker
DOCKER_GID=121
