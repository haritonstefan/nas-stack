# WebUI login is the shared identity in shared.env (ADMIN_USER/ADMIN_PASSWORD),
# not a qBittorrent-only credential — Sonarr/Radarr's download client and the
# Homepage widget all read it from there.

QBITTORRENT_CONFIG_DIR=/volume2/docker/qbittorrent/config
QBITTORRENT_PORT=8080
QBITTORRENT_TORRENT_PORT=6881

# Seed until ratio 2.0 or 14 days. qBittorrent then stops the torrent, and
# Sonarr/Radarr delete it AND its files (removeCompletedDownloads), freeing the
# SSD. Applied via qBittorrent.conf at first start, so changes here need that
# file removed.
QBITTORRENT_SEED_RATIO=2
QBITTORRENT_SEED_MINUTES=20160
