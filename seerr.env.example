SEERR_CONFIG_DIR=/volume2/docker/seerr/config
SEERR_PORT=5055

# --- secret: generated by nas install on first run, never regenerated -------------

# Injected as Seerr's API_KEY, which overwrites the apiKey stored in its
# settings.json at every start — load-bearing forever, like the arr keys.
# Rotating the key in the Seerr UI does not survive a restart.
SEERR_API_KEY=

# --- seerr-bootstrap.sh only (not read by docker compose) -------------------

# How the bootstrap (running on the host) reaches Seerr. Not used by anything
# inside a container.
SEERR_URL=http://127.0.0.1:5055

# The port Seerr reaches Jellyfin on, at shared.env's LAN_HOST (see the spec).
SEERR_JELLYFIN_PORT=8096

# 0 skips Seerr's first-run setup (Jellyfin sign-in, library sync, Sonarr/
# Radarr wiring). The Jellyfin admin credentials are NOT duplicated here: the
# bootstrap reads ADMIN_USER/ADMIN_PASSWORD from shared.env directly.
#
# Named ARR_CONFIGURE_SEERR while this was part of arr-bootstrap.sh; that name
# is still read as a fallback, so an existing env file keeps working.
SEERR_CONFIGURE=1
