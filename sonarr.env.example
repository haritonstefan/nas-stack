SONARR_CONFIG_DIR=/volume2/docker/sonarr/config
SONARR_PORT=8989

# Single-consumer, unlike DOWNLOADS_DIR (shared.env): only Sonarr reads this.
ARR_SERIES_DIR=/volume1/Media/Series

# --- secret: generated by up.sh on first run, never regenerated -------------

# 32-char lowercase hex, matching the app's own key format. Read at every
# start as SONARR__AUTH__APIKEY and never persisted to config.xml — losing
# this file mints a new key silently, breaking Prowlarr sync, Configarr and
# the Homepage widget all at once, with no error anywhere.
SONARR_API_KEY=

# --- arr-bootstrap.sh only (not read by docker compose) ---------------------

# How the bootstrap (running on the host) reaches Sonarr. Not used by
# anything inside a container: containers reach it as http://sonarr:8989.
SONARR_URL=http://127.0.0.1:8989

# Container path, not a host path — what the app sees.
SONARR_ROOT_FOLDER=/media/series
