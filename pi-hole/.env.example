# Pi-hole web UI password (v6 login is password-only, no username).
# The only secret here — no default, compose fails loudly if unset.
PIHOLE_PASSWORD=

# The container's own LAN IP. Must be OUTSIDE the router's DHCP pool
# (or have a DHCP reservation), or the router may hand it to another device.
PIHOLE_IP=192.168.0.53

# Host NIC the macvlan attaches to. On UGOS the NIC sits inside a bridge,
# so this is bridge0, not eth0. Verify on the NAS:
#   ip route get 1.1.1.1 | head -1   # "dev <name>" is the value to use
MACVLAN_PARENT=bridge0

# LAN facts.
LAN_SUBNET=192.168.0.0/24
LAN_GATEWAY=192.168.0.1

# Upstream resolvers Pi-hole forwards to (semicolon-separated).
PIHOLE_UPSTREAMS='1.1.1.1;1.0.0.1'

# Where /etc/pihole persists. Default is next to this compose file;
# on the NAS point it at the SSD, e.g. /volume2/docker/pihole/etc-pihole
PIHOLE_CONFIG_DIR=./etc-pihole

TZ=Europe/Bucharest
